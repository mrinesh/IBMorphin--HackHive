{
  "schema_version": "1.0",
  "project_name": "Multisensor Engine Signature Extraction and Fault Recognition",
  "engine": {
    "cylinders": 4,
    "strokes": 4,
    "displacement_l": 1.6,
    "firing_order": [1, 3, 4, 2],
    "cam_sync_angle_deg": 0,
    "rpm_min": 800,
    "rpm_max": 3500,
    "load_min": 0.2,
    "load_max": 0.8
  },
  "streams": {
    "audio": {
      "sample_rate_hz": 24000,
      "channels": 1,
      "unit": "normalized_sensor_units"
    },
    "vibration": {
      "sample_rate_hz": 25600,
      "channels": 1,
      "unit": "nominal_m_per_s2"
    },
    "telemetry_rates_hz": {
      "rpm": 50,
      "load": 10,
      "throttle": 10,
      "coolant_temp": 1,
      "short_term_fuel_trim": 2,
      "long_term_fuel_trim": 2
    },
    "crank_wheel": {
      "teeth_per_rev": 60,
      "missing_teeth": 2,
      "first_tooth_angle_deg": 270,
      "timer_resolution_s": 1e-6
    },
    "thermal": {
      "egt_rate_hz": 10,
      "cht_rate_hz": 2,
      "unit": "degC"
    }
  },
  "analysis": {
    "window_s": 2.0,
    "step_s": 0.5,
    "audio_low_hz": 20,
    "vibration_low_hz": 5,
    "high_hz": 10000,
    "fft_window": "hann",
    "welch_segment_samples": 8192,
    "welch_overlap_fraction": 0.5,
    "stft_segment_samples": 2048,
    "stft_hop_samples": 512
  },
  "runtime": {
    "packet_s": 0.04,
    "confirm_fault_updates": 2,
    "clear_fault_updates": 3,
    "processing_p95_goal_ms": 250,
    "rpm_max_age_s": 0.1,
    "load_throttle_max_age_s": 0.3,
    "max_missing_fraction": 0.01,
    "max_clipped_fraction": 0.005
  },
  "dataset": {
    "master_seed": 20261015,
    "integration_runs": 16,
    "integration_duration_s": 20,
    "core_duration_s": 30,
    "engine_count": 30,
    "runs_per_engine": 8,
    "split_engines": {"train": 18, "tuning": 4, "calibration": 4, "test": 4},
    "challenge_runs": 16
  },
  "obd_misfire": {
    "type_a_revs": 200,
    "type_a_rate_pct": 5.0,
    "type_b_revs": 1000,
    "type_b_rate_pct": 1.5,
    "single_cylinder_share": 0.8,
    "rpm_bin_edges": [600, 1200, 1600, 2000, 2400, 2800, 3200, 4000],
    "stroke_threshold_quantile": 0.9999,
    "threshold_margin": 1.25,
    "min_strokes_per_bin": 2000
  },
  "crank_detector": {
    "stroke_lag_s": 0.15,
    "cylinder_threshold_quantile": 0.999,
    "threshold_margin": 1.25,
    "confirm_updates": 2,
    "clear_updates": 3
  },
  "thermal_detector": {
    "quantile": 0.999,
    "threshold_margin": 1.25,
    "min_z": 4.0,
    "min_spread_c": {"egt": 1.0, "cht": 0.3},
    "confirm_updates": 4,
    "clear_updates": 6
  },
  "conditions": ["normal", "misfire", "knock_like", "valve_clearance_like"],
  "inference_context_fields": ["rpm", "load", "throttle"]
}
