# Copy to .env (git-ignored) in the repository root, or set GEMINI_API_KEY as an
# environment variable (which takes precedence).

# Google Gemini API key for the dashboard's "Diagnose" (possible causes) button.
# Free key: sign in at https://aistudio.google.com/apikey and choose "Create API key".
# The free tier is enough; no billing is needed. Without a key, Diagnose shows the
# basic rule-based diagnosis instead.
GEMINI_API_KEY=
