{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engine diagnostics MVP configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_name", "engine", "streams", "analysis", "runtime", "dataset", "conditions", "inference_context_fields"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_name": {"type": "string", "minLength": 1},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cylinders", "strokes", "displacement_l", "firing_order", "cam_sync_angle_deg", "rpm_min", "rpm_max", "load_min", "load_max"],
      "properties": {
        "cylinders": {"const": 4},
        "strokes": {"const": 4},
        "displacement_l": {"type": "number", "exclusiveMinimum": 0},
        "firing_order": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4}},
        "cam_sync_angle_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 720},
        "rpm_min": {"type": "number", "exclusiveMinimum": 0},
        "rpm_max": {"type": "number", "exclusiveMinimum": 0},
        "load_min": {"type": "number", "minimum": 0, "maximum": 1},
        "load_max": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio", "vibration", "telemetry_rates_hz"],
      "properties": {
        "audio": {"$ref": "#/$defs/waveform"},
        "vibration": {"$ref": "#/$defs/waveform"},
        "telemetry_rates_hz": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rpm", "load", "throttle", "coolant_temp", "short_term_fuel_trim", "long_term_fuel_trim"],
          "properties": {
            "rpm": {"$ref": "#/$defs/positiveNumber"},
            "load": {"$ref": "#/$defs/positiveNumber"},
            "throttle": {"$ref": "#/$defs/positiveNumber"},
            "coolant_temp": {"$ref": "#/$defs/positiveNumber"},
            "short_term_fuel_trim": {"$ref": "#/$defs/positiveNumber"},
            "long_term_fuel_trim": {"$ref": "#/$defs/positiveNumber"}
          }
        },
        "crank_wheel": {
          "description": "Crank trigger wheel for data contract 1.2 tooth-edge streams.",
          "type": "object",
          "additionalProperties": false,
          "required": ["teeth_per_rev", "missing_teeth", "first_tooth_angle_deg", "timer_resolution_s"],
          "properties": {
            "teeth_per_rev": {"type": "integer", "minimum": 12},
            "missing_teeth": {"type": "integer", "minimum": 1},
            "first_tooth_angle_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
            "timer_resolution_s": {"$ref": "#/$defs/positiveNumber"}
          }
        },
        "thermal": {
          "description": "Per-cylinder EGT and CHT telemetry for data contract 1.2.",
          "type": "object",
          "additionalProperties": false,
          "required": ["egt_rate_hz", "cht_rate_hz", "unit"],
          "properties": {
            "egt_rate_hz": {"$ref": "#/$defs/positiveNumber"},
            "cht_rate_hz": {"$ref": "#/$defs/positiveNumber"},
            "unit": {"const": "degC"}
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_s", "step_s", "audio_low_hz", "vibration_low_hz", "high_hz", "fft_window", "welch_segment_samples", "welch_overlap_fraction", "stft_segment_samples", "stft_hop_samples"],
      "properties": {
        "window_s": {"$ref": "#/$defs/positiveNumber"},
        "step_s": {"$ref": "#/$defs/positiveNumber"},
        "audio_low_hz": {"$ref": "#/$defs/positiveNumber"},
        "vibration_low_hz": {"$ref": "#/$defs/positiveNumber"},
        "high_hz": {"$ref": "#/$defs/positiveNumber"},
        "fft_window": {"const": "hann"},
        "welch_segment_samples": {"type": "integer", "minimum": 2},
        "welch_overlap_fraction": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "stft_segment_samples": {"type": "integer", "minimum": 2},
        "stft_hop_samples": {"type": "integer", "minimum": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_s", "confirm_fault_updates", "clear_fault_updates", "processing_p95_goal_ms", "rpm_max_age_s", "load_throttle_max_age_s", "max_missing_fraction", "max_clipped_fraction"],
      "properties": {
        "packet_s": {"$ref": "#/$defs/positiveNumber"},
        "confirm_fault_updates": {"type": "integer", "minimum": 1},
        "clear_fault_updates": {"type": "integer", "minimum": 1},
        "processing_p95_goal_ms": {"$ref": "#/$defs/positiveNumber"},
        "rpm_max_age_s": {"$ref": "#/$defs/positiveNumber"},
        "load_throttle_max_age_s": {"$ref": "#/$defs/positiveNumber"},
        "max_missing_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "max_clipped_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "obd_misfire": {
      "description": "Simulated OBD-II crankshaft-speed misfire monitor (benchmark; contract 1.2 data).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type_a_revs", "type_a_rate_pct", "type_b_revs", "type_b_rate_pct", "single_cylinder_share", "rpm_bin_edges", "stroke_threshold_quantile", "threshold_margin", "min_strokes_per_bin"],
      "properties": {
        "type_a_revs": {"type": "integer", "minimum": 1},
        "type_a_rate_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "type_b_revs": {"type": "integer", "minimum": 1},
        "type_b_rate_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "single_cylinder_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "rpm_bin_edges": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/positiveNumber"}},
        "stroke_threshold_quantile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "threshold_margin": {"$ref": "#/$defs/positiveNumber"},
        "min_strokes_per_bin": {"type": "integer", "minimum": 1}
      }
    },
    "crank_detector": {
      "description": "Independent crank-speed misfire path (contract 1.2 data).",
      "type": "object",
      "additionalProperties": false,
      "required": ["stroke_lag_s", "cylinder_threshold_quantile", "threshold_margin", "confirm_updates", "clear_updates"],
      "properties": {
        "stroke_lag_s": {"$ref": "#/$defs/positiveNumber"},
        "cylinder_threshold_quantile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "threshold_margin": {"$ref": "#/$defs/positiveNumber"},
        "confirm_updates": {"type": "integer", "minimum": 1},
        "clear_updates": {"type": "integer", "minimum": 1}
      }
    },
    "thermal_detector": {
      "description": "Per-cylinder EGT/CHT cross-check (contract 1.2 data).",
      "type": "object",
      "additionalProperties": false,
      "required": ["quantile", "threshold_margin", "min_z", "min_spread_c", "confirm_updates", "clear_updates"],
      "properties": {
        "quantile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "threshold_margin": {"$ref": "#/$defs/positiveNumber"},
        "min_z": {"$ref": "#/$defs/positiveNumber"},
        "min_spread_c": {
          "type": "object", "additionalProperties": false, "required": ["egt", "cht"],
          "properties": {"egt": {"$ref": "#/$defs/positiveNumber"}, "cht": {"$ref": "#/$defs/positiveNumber"}}
        },
        "confirm_updates": {"type": "integer", "minimum": 1},
        "clear_updates": {"type": "integer", "minimum": 1}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["master_seed", "integration_runs", "integration_duration_s", "core_duration_s", "engine_count", "runs_per_engine", "split_engines", "challenge_runs"],
      "properties": {
        "master_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "integration_runs": {"type": "integer", "minimum": 1},
        "integration_duration_s": {"$ref": "#/$defs/positiveNumber"},
        "core_duration_s": {"$ref": "#/$defs/positiveNumber"},
        "engine_count": {"type": "integer", "minimum": 4},
        "runs_per_engine": {"type": "integer", "minimum": 4},
        "split_engines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "tuning", "calibration", "test"],
          "properties": {
            "train": {"type": "integer", "minimum": 1},
            "tuning": {"type": "integer", "minimum": 1},
            "calibration": {"type": "integer", "minimum": 1},
            "test": {"type": "integer", "minimum": 1}
          }
        },
        "challenge_runs": {"type": "integer", "minimum": 0}
      }
    },
    "conditions": {"const": ["normal", "misfire", "knock_like", "valve_clearance_like"]},
    "inference_context_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["rpm", "load", "throttle"]}
    }
  },
  "$defs": {
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0},
    "waveform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate_hz", "channels", "unit"],
      "properties": {
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "channels": {"const": 1},
        "unit": {"type": "string", "minLength": 1}
      }
    }
  }
}
